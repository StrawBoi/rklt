# ============================================================================
# RKLT FREIGHT FORWARDING — EMAIL & CONTACT FORM CONFIGURATION
# Copy this file to `.env.local` and fill in your credentials.
# ============================================================================

# 1. Receiver Email Address (Where contact form inquiries will be delivered)
#    You can provide a single email or comma-separated list of emails:
CONTACT_RECEIVER_EMAIL="operations@rklt.ltd"

# 2. Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Verified Sender Address in Resend
#    Use "RKLT Operations Desk <onboarding@resend.dev>" for instant testing,
#    or your verified domain e.g. "RKLT Operations Desk <dispatch@rklt.ltd>"
RESEND_FROM="RKLT Operations Desk <dispatch@rklt.ltd>"
